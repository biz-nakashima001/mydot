[Unit]
Description=MyDot FastAPI Web Interface
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shinya
WorkingDirectory=/home/shinya/mydot

ExecStart=/home/shinya/mydot/.venv/bin/uvicorn api:app --host 0.0.0.0 --port 8080

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
